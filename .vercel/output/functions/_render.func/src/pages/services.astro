---
import MainLayout from "../layouts/MainLayout.astro";

const services = [
  {
    number: "01",
    title: "Social Media Management",
    description:
      "Build a strong and consistent presence across social media with strategic content, creative posts, captions, community management, and ongoing account handling.",
    items: [
      "Content planning",
      "Creative posts & stories",
      "Captions & hashtags",
      "Community management",
    ],
  },
  {
    number: "02",
    title: "Branding & Graphic Design",
    description:
      "Create a professional and memorable brand identity with creative designs that communicate your business clearly across digital and print platforms.",
    items: [
      "Brand identity",
      "Logo design",
      "Social media creatives",
      "Marketing & promotional designs",
    ],
  },
  {
    number: "03",
    title: "Website Development",
    description:
      "Modern, responsive websites designed to represent your brand, provide a great user experience, and help turn visitors into customers.",
    items: [
      "Responsive website design",
      "Business websites",
      "Landing pages",
      "Website optimization",
    ],
  },
  {
    number: "04",
    title: "SEO",
    description:
      "Improve your online visibility and help your business reach the right audience through practical search engine optimization strategies.",
    items: [
      "Keyword research",
      "On-page SEO",
      "Technical optimization",
      "Search visibility improvement",
    ],
  },
  {
    number: "05",
    title: "Meta Ads & Google Ads",
    description:
      "Reach potential customers with targeted advertising campaigns across Meta and Google, supported by creative strategy, audience targeting, and campaign optimization.",
    items: [
      "Campaign setup",
      "Audience targeting",
      "Ad creative strategy",
      "Campaign optimization",
    ],
  },
  {
    number: "06",
    title: "Content Creation",
    description:
      "Create engaging and useful content that strengthens your brand, communicates your message, and keeps your audience interested.",
    items: [
      "Social media content",
      "Promotional content",
      "Campaign creatives",
      "Content planning",
    ],
  },
];
---

<MainLayout
  title="Services | NextStep Digital"
  description="Explore NextStep Digital's social media management, branding, graphic design, website development, SEO, advertising, and content creation services."
>

  <main>

    <!-- Hero -->
    <section class="py-16 md:py-24">
      <div class="max-w-7xl mx-auto px-6">

        <div class="max-w-4xl mx-auto text-center">

          <span
            class="inline-block bg-[#0F2347] text-white px-5 py-2 rounded-lg text-lg mb-6"
          >
            Our Services
          </span>

          <h1 class="text-4xl md:text-6xl font-bold leading-tight">
            Digital Solutions
            <br />
            <span class="text-blue-600">Built for Growth.</span>
          </h1>

          <p class="mt-7 text-lg md:text-xl text-gray-600 leading-8 max-w-3xl mx-auto">
            We help businesses build their brand, strengthen their online
            presence, reach the right audience, and take their next step
            digitally.
          </p>

        </div>

      </div>
    </section>


    <!-- Services -->
    <section class="pb-20">
      <div class="max-w-7xl mx-auto px-6">

        <div class="grid md:grid-cols-2 gap-6">

          {
            services.map((service) => (
              <div
  id={service.title === "Social Media Management"
    ? "social-media-management"
    : service.title === "Branding & Graphic Design"
    ? "branding-graphic-design"
    : service.title === "Website Development"
    ? "website-development"
    : service.title === "SEO"
    ? "seo"
    : service.title === "Meta Ads & Google Ads"
    ? "meta-ads-google-ads"
    : "content-creation"}
  class="group scroll-mt-28 rounded-[30px] border border-gray-200 p-7 md:p-9 bg-white hover:bg-[#0F2347] hover:text-white transition-all duration-300"
>
                <div class="flex items-start justify-between gap-5">

                  <span
                    class="text-blue-600 group-hover:text-blue-300 text-lg font-semibold"
                  >
                    {service.number}
                  </span>

                  <span
                    class="text-gray-400 group-hover:text-white/60 text-2xl"
                  >
                    ↗
                  </span>

                </div>

                <h2 class="mt-8 text-2xl md:text-3xl font-bold">
                  {service.title}
                </h2>

                <p
                  class="mt-5 text-gray-600 group-hover:text-white/75 leading-7"
                >
                  {service.description}
                </p>

                <ul class="mt-7 space-y-3">

                  {
                    service.items.map((item) => (
                      <li class="flex items-center gap-3">
                        <span class="w-2 h-2 rounded-full bg-blue-600 group-hover:bg-blue-300"></span>
                        <span>{item}</span>
                      </li>
                    ))
                  }

                </ul>

              </div>
            ))
          }

        </div>

      </div>
    </section>


    <!-- CTA -->
    <section class="pb-20">
      <div class="max-w-7xl mx-auto px-6">

        <div
          class="bg-[#0F2347] text-white rounded-[35px] px-8 py-14 md:px-16 text-center"
        >

          <h2 class="text-3xl md:text-5xl font-bold">
            Ready to Take Your Next Step?
          </h2>

          <p class="mt-5 text-white/75 text-lg max-w-2xl mx-auto leading-8">
            Let's discuss your business goals and find the right digital
            solutions to help you grow.
          </p>

     <a
  href="/#contact"
  class="relative z-10 inline-flex mt-8 px-8 py-4 bg-white text-[#0F2347] rounded-2xl font-semibold hover:bg-blue-600 hover:text-white transition"
>
  Get Free Consultation
</a>

        </div>

      </div>
    </section>

  </main>

</MainLayout>