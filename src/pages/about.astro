---
import MainLayout from "../layouts/MainLayout.astro";
---

<MainLayout title="About Us | NextStep Digital">

  <main>

    <!-- About Hero -->
    <section class="py-16 md:py-24">
      <div class="max-w-7xl mx-auto px-6">

        <div class="max-w-4xl mx-auto text-center">

          <span
            class="inline-block bg-[#0F2347] text-white px-5 py-2 rounded-lg text-lg mb-6"
          >
            About Us
          </span>

          <h1 class="text-4xl md:text-6xl font-bold leading-tight">
            We Help Businesses
            <br />
            <span class="text-blue-600">Move Forward.</span>
          </h1>

          <p class="mt-8 text-lg md:text-xl leading-8 text-gray-600">
            NextStep Digital is a creative digital marketing agency helping
            businesses build a strong online presence, connect with their
            audience, and achieve sustainable growth.
          </p>

        </div>

      </div>
    </section>


    <!-- Who We Are -->
    <section class="pb-16 md:pb-24">
      <div class="max-w-7xl mx-auto px-6">

        <div class="grid md:grid-cols-2 gap-12 items-center">

          <div>
            <span
              class="inline-block bg-[#0F2347] text-white px-4 py-2 rounded-lg text-lg mb-5"
            >
              Who We Are
            </span>

            <h2 class="text-3xl md:text-5xl font-bold leading-tight">
              Your Digital Growth Partner
            </h2>
          </div>

          <div class="text-gray-600 text-lg leading-8">
            <p>
              We work with businesses that want to grow, improve their
              visibility, and create a stronger digital presence.
            </p>

            <p class="mt-5">
              From social media and creative design to websites, branding,
              SEO and digital advertising, we bring strategy and creativity
              together to create meaningful results.
            </p>
          </div>

        </div>

      </div>
    </section>


    <!-- Vision & Mission -->
    <section class="py-16 md:py-24 bg-[#F5F7FA]">
      <div class="max-w-7xl mx-auto px-6">

        <div class="grid md:grid-cols-2 gap-8">

          <div class="bg-white rounded-[30px] p-8 md:p-12">
            <h2 class="text-3xl font-bold mb-5">
              Our Vision
            </h2>

            <p class="text-gray-600 text-lg leading-8">
              To become a trusted digital growth partner for businesses by
              delivering creative, practical and result-driven digital
              solutions.
            </p>
          </div>

          <div class="bg-[#0F2347] text-white rounded-[30px] p-8 md:p-12">
            <h2 class="text-3xl font-bold mb-5">
              Our Mission
            </h2>

            <p class="text-white/80 text-lg leading-8">
              To help businesses take their next step through smart digital
              marketing, strong branding, creative content and effective
              online strategies.
            </p>
          </div>

        </div>

      </div>
    </section>


    <!-- What We Do -->
    <section class="py-16 md:py-24">
      <div class="max-w-7xl mx-auto px-6">

        <div class="text-center max-w-3xl mx-auto">

          <span
            class="inline-block bg-[#0F2347] text-white px-4 py-2 rounded-lg text-lg mb-5"
          >
            What We Do
          </span>

          <h2 class="text-3xl md:text-5xl font-bold">
            Everything You Need to Grow Online
          </h2>

          <p class="mt-6 text-gray-600 text-lg leading-8">
            We provide practical digital marketing solutions designed around
            your business goals.
          </p>

        </div>


        <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6 mt-12">

          <div class="border border-gray-200 rounded-[25px] p-7">
            <h3 class="text-2xl font-semibold mb-3">
              Social Media
            </h3>
            <p class="text-gray-600 leading-7">
              Strategic social media management and engaging content that
              keeps your brand active and connected.
            </p>
          </div>

          <div class="border border-gray-200 rounded-[25px] p-7">
            <h3 class="text-2xl font-semibold mb-3">
              Branding & Design
            </h3>
            <p class="text-gray-600 leading-7">
              Creative branding and visual design that gives your business a
              professional and memorable identity.
            </p>
          </div>

          <div class="border border-gray-200 rounded-[25px] p-7">
            <h3 class="text-2xl font-semibold mb-3">
              Website Development
            </h3>
            <p class="text-gray-600 leading-7">
              Modern, responsive websites designed to represent your brand
              and convert visitors into customers.
            </p>
          </div>

          <div class="border border-gray-200 rounded-[25px] p-7">
            <h3 class="text-2xl font-semibold mb-3">
              SEO
            </h3>
            <p class="text-gray-600 leading-7">
              Search engine optimization strategies that improve visibility
              and help your business reach the right audience.
            </p>
          </div>

          <div class="border border-gray-200 rounded-[25px] p-7">
            <h3 class="text-2xl font-semibold mb-3">
              Meta & Google Ads
            </h3>
            <p class="text-gray-600 leading-7">
              Performance-focused advertising campaigns built to reach
              potential customers and generate meaningful results.
            </p>
          </div>

          <div class="border border-gray-200 rounded-[25px] p-7">
            <h3 class="text-2xl font-semibold mb-3">
              Creative Content
            </h3>
            <p class="text-gray-600 leading-7">
              Posters, campaigns, promotional creatives and digital content
              tailored to your brand.
            </p>
          </div>

        </div>

      </div>
    </section>


    <!-- CTA -->
    <section class="pb-20">
      <div class="max-w-7xl mx-auto px-6">

        <div
          class="bg-[#0F2347] text-white rounded-[35px] px-8 py-14 md:px-16 text-center"
        >

          <h2 class="text-3xl md:text-5xl font-bold">
            Ready to Take Your Next Step?
          </h2>

          <p class="mt-5 text-white/80 text-lg max-w-2xl mx-auto">
            Let's build your digital presence and grow your business
            together.
          </p>

          <a
            href="/#contact"
            class="inline-flex mt-8 px-8 py-4 bg-white text-[#0F2347] rounded-2xl font-semibold hover:bg-blue-600 hover:text-white transition"
          >
            Get Free Consultation
          </a>

        </div>

      </div>
    </section>

  </main>

</MainLayout>