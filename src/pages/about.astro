---
import MainLayout from "../layouts/MainLayout.astro";
import Sponsors from "../components/sections/Sponsors.astro";
import Services from "../components/sections/Services.astro";
---

<MainLayout title="About NextStep Digital">
	<main class="space-y-20">
        <div class="py-8 px-4 mx-auto max-w-screen-xl lg:py-16 lg:px-3">
            <div class="relative flex flex-col-reverse items-center md:flex-row" id="hero">
                <div class="row items-center py-5 md:pb-20 md:pt-10">
                    <div class="text-center space-y-10">
                        <h2 class="text-5xl font-medium leading-none md:text-6xl">About <br> NextStep <br> Digital</h2>
                        <p class="mt-6 mb-8  text-xl font-normal leading-7 sm:mb-12">NextStep Digital helps businesses grow through social media handling, creative branding, Meta Ads, Google Ads, website development, and performance-driven digital marketing.</p>
                        <a class="px-9 py-5 bg-zinc-900 hover:bg-blue-900 text-white transition-all duration-300 border rounded-2xl justify-items-center md:justify-items-start gap-2.5 inline-flex" rel="noopener noreferrer" href="#contact" target="_blank">
                            <h2 class="text-center text-xl font-normal leading-7">Get Free Consultation</h2>
                        </a>
                    </div>
                </div>
            </div>
        </div>
        <Sponsors />
        <Services />
	</main>
</MainLayout>

