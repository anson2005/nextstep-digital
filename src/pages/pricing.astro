---
import MainLayout from "../layouts/MainLayout.astro";
---

<MainLayout title="Pricing">
  <main class="bg-white ns-pricing-detail">

    <!-- Pricing Header -->
    <section class="px-6 pt-16 pb-10 md:pt-20 md:pb-14">
      <div class="max-w-4xl mx-auto text-center">

        <h1 class="text-4xl md:text-5xl font-extrabold text-[#0F2347]">
          Social Media Management Plans
        </h1>

        <p class="mt-5 text-base md:text-lg text-gray-600">
          Flexible plans designed for modern brands
        </p>

      </div>
    </section>


    <!-- Pricing Cards -->
    <section class="px-5 md:px-8 pb-16">
      <div class="max-w-7xl mx-auto grid md:grid-cols-3 gap-6 lg:gap-8">

        <!-- STARTER -->
        <div data-tilt class="ns-detail-card rounded-[28px] overflow-hidden border border-[#0F2347]/15 bg-white shadow-sm">

          <div class="ns-detail-card-head px-6 py-8 text-center">
            <h2 class="text-2xl font-bold">
              Starter
            </h2>

            <p class="mt-3 text-sm text-white/80">
              Perfect for businesses starting their online presence.
            </p>

            <div class="mt-6">
              <span class="text-4xl font-extrabold">
                ₹6999
              </span>

              <span class="text-white/70 text-sm">
                /month
              </span>
            </div>
          </div>

          <div class="p-6">
            <ul class="space-y-4 text-gray-700 text-sm md:text-base">

              <li>✓ 12 Creative Posters</li>
              <li>✓ 12 Story Designs</li>
              <li>✓ Social Media Handling</li>
              <li>✓ Captions + Smart Hashtags</li>
              <li>✓ Account Setup &amp; Optimization</li>
              <li>✓ Monthly Content Planning</li>
              <li>✓ Basic Support</li>

            </ul>

            <a
              href="/#contact"
              class="block mt-8 w-full rounded-xl bg-[#0F2347] hover:bg-blue-600 text-white text-center py-3 font-semibold transition"
            >
              Get Started
            </a>
          </div>

        </div>


        <!-- GROWTH -->
        <div data-tilt class="ns-detail-card rounded-[28px] overflow-hidden border border-[#0F2347]/15 bg-white shadow-sm relative">

          <!-- Popular -->
          <div class="ns-detail-popular">MOST POPULAR</div>

          <div class="ns-detail-card-head px-6 py-8 text-center">

            <h2 class="text-2xl font-bold">
              Growth
            </h2>

            <p class="mt-3 text-sm text-white/80">
              Designed for growing brands that need stronger engagement and consistency.
            </p>

            <div class="mt-6">
              <span class="text-4xl font-extrabold">
                ₹9999
              </span>

              <span class="text-white/70 text-sm">
                /month
              </span>
            </div>

          </div>

          <div class="p-6">
            <ul class="space-y-4 text-gray-700 text-sm md:text-base">

              <li>✓ 16 Creative Posters</li>
              <li>✓ 16 Story Designs</li>
              <li>✓ Social Media Handling</li>
              <li>✓ Captions + Smart Hashtags</li>
              <li>✓ Ad Campaign Setup</li>
              <li>✓ Monthly Performance Report</li>
              <li>✓ Content Planning</li>
              <li>✓ Priority Support</li>

            </ul>

            <a
              href="/#contact"
              class="block mt-8 w-full rounded-xl bg-[#0F2347] hover:bg-blue-600 text-white text-center py-3 font-semibold transition"
            >
              Get Started
            </a>
          </div>

        </div>


        <!-- PREMIUM -->
        <div data-tilt class="ns-detail-card rounded-[28px] overflow-hidden border border-[#0F2347]/15 bg-white shadow-sm">

          <div class="ns-detail-card-head px-6 py-8 text-center">

            <h2 class="text-2xl font-bold">
              Premium
            </h2>

            <p class="mt-3 text-sm text-white/80">
              Complete branding and marketing support for businesses.
            </p>

            <div class="mt-6">
              <span class="text-4xl font-extrabold">
                ₹11999
              </span>

              <span class="text-white/70 text-sm">
                /month
              </span>
            </div>

          </div>

          <div class="p-6">
            <ul class="space-y-4 text-gray-700 text-sm md:text-base">

              <li>✓ 21 Creative Posters</li>
              <li>✓ 21 Story Designs</li>
              <li>✓ 2 Reels / Month</li>
              <li>✓ Full Social Media Handling</li>
              <li>✓ Captions + Smart Hashtags</li>
              <li>✓ Advanced Ad Campaign Setup</li>
              <li>✓ Monthly Analytics Report</li>
              <li>✓ Account Optimization</li>
              <li>✓ Priority Support</li>

            </ul>

            <a
              href="/#contact"
              class="block mt-8 w-full rounded-xl bg-[#0F2347] hover:bg-blue-600 text-white text-center py-3 font-semibold transition"
            >
              Get Started
            </a>
          </div>

        </div>

      </div>
    </section>


    <!-- Optional Add-ons -->
    <section class="px-5 md:px-8 pb-20">
      <div class="max-w-7xl mx-auto">

        <div class="text-center mb-8">
          <h2 class="text-2xl md:text-3xl font-bold text-[#0F2347]">
            Optional Add-ons
          </h2>

          <p class="mt-2 text-gray-500">
            Additional creative and marketing services
          </p>
        </div>

        <div class="grid grid-cols-2 md:grid-cols-5 gap-4">

          <div class="rounded-2xl border p-5 text-center">
            <p class="font-semibold text-[#0F2347]">
              Logo Design
            </p>
          </div>

          <div class="rounded-2xl border p-5 text-center">
            <p class="font-semibold text-[#0F2347]">
              Brochure Design
            </p>
          </div>

          <div class="rounded-2xl border p-5 text-center">
            <p class="font-semibold text-[#0F2347]">
              Event Posters
            </p>
          </div>

          <div class="rounded-2xl border p-5 text-center">
            <p class="font-semibold text-[#0F2347]">
              Paid Advertisement Management
            </p>
          </div>

          <div class="rounded-2xl border p-5 text-center">
            <p class="font-semibold text-[#0F2347]">
              Festival Campaign Creatives
            </p>
          </div>

        </div>

      </div>
    </section>


    <!-- Bottom Note -->
    <section class="px-6 pb-16">
      <div class="max-w-4xl mx-auto text-center">

        <div class="border-t border-gray-200 pt-8">
          <p class="text-sm tracking-[0.2em] uppercase text-[#0F2347] font-semibold">
            All prices are monthly
          </p>
        </div>

      </div>
    </section>

    <script>
      const pricingTiltCards = document.querySelectorAll<HTMLElement>(".ns-pricing-detail [data-tilt]");
      if (window.matchMedia("(hover: hover) and (pointer: fine)").matches && !window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
        pricingTiltCards.forEach((card) => {
          card.addEventListener("pointermove", (event) => {
            const rect = card.getBoundingClientRect();
            const x = (event.clientX - rect.left) / rect.width;
            const y = (event.clientY - rect.top) / rect.height;
            card.style.setProperty("--rx", `${(0.5 - y) * 4}deg`);
            card.style.setProperty("--ry", `${(x - 0.5) * 5}deg`);
          });
          card.addEventListener("pointerleave", () => {
            card.style.setProperty("--rx", "0deg");
            card.style.setProperty("--ry", "0deg");
          });
        });
      }
    </script>
    <style>
      .ns-pricing-detail .ns-detail-card{position:relative;overflow:hidden;background:linear-gradient(145deg,#fff,#f3f7ff);border:1px solid #d9e5f5;box-shadow:0 14px 34px #0a28530d;transform:perspective(1000px) rotateX(var(--rx,0deg)) rotateY(var(--ry,0deg));transform-style:preserve-3d;transition:transform .25s ease,background .3s ease,color .3s ease,box-shadow .3s ease,border-color .3s ease}
      .ns-pricing-detail .ns-detail-card-head{background:transparent;color:#0f2347;border-bottom:1px solid #e1eaf5}
      .ns-pricing-detail .ns-detail-card-head p{color:#64748b}
      .ns-pricing-detail .ns-detail-card-head span{color:#64748b!important}
      .ns-pricing-detail .ns-detail-card ul{transition:color .25s}
      .ns-pricing-detail .ns-detail-card a{transition:background .2s,transform .2s}
      .ns-pricing-detail .ns-detail-popular{position:absolute;z-index:2;top:15px;right:15px;padding:6px 10px;border-radius:99px;background:#dcecff;color:#0a3470;font-size:9px;font-weight:900;letter-spacing:.08em}
      @media(hover:hover) and (pointer:fine){.ns-pricing-detail .ns-detail-card:hover{background:linear-gradient(145deg,#124b9e,#071e48);border-color:#398cff;box-shadow:0 24px 52px #0a4cae35;color:#fff;transform:perspective(1000px) rotateX(var(--rx,0deg)) rotateY(var(--ry,0deg)) translateY(-7px)}.ns-pricing-detail .ns-detail-card:hover .ns-detail-card-head{background:transparent;color:#fff;border-color:#ffffff30}.ns-pricing-detail .ns-detail-card:hover .ns-detail-card-head p,.ns-pricing-detail .ns-detail-card:hover ul{color:#d6e8ff}.ns-pricing-detail .ns-detail-card:hover a{background:#fff;color:#0f2347}}
      @media(max-width:767px){.ns-pricing-detail .ns-detail-card:active{background:linear-gradient(145deg,#124b9e,#071e48);color:#fff}.ns-pricing-detail .ns-detail-card:active .ns-detail-card-head{color:#fff;background:transparent}.ns-pricing-detail .ns-detail-card:active .ns-detail-card-head p{color:#d6e8ff}}
      @media(prefers-reduced-motion:reduce){.ns-pricing-detail .ns-detail-card{transition:none}}
    </style>
  </main>
</MainLayout>