---
import MainLayout from "../layouts/MainLayout.astro";
---

<MainLayout title="Pricing">
  <main class="bg-white">

    <!-- Pricing Header -->
    <section class="px-6 pt-16 pb-10 md:pt-20 md:pb-14">
      <div class="max-w-4xl mx-auto text-center">

        <h1 class="text-4xl md:text-5xl font-extrabold text-[#0F2347]">
          Social Media Management Plans
        </h1>

        <p class="mt-5 text-base md:text-lg text-gray-600">
          Flexible plans designed for modern brands
        </p>

      </div>
    </section>


    <!-- Pricing Cards -->
    <section class="px-5 md:px-8 pb-16">
      <div class="max-w-7xl mx-auto grid md:grid-cols-3 gap-6 lg:gap-8">

        <!-- STARTER -->
        <div class="rounded-[28px] overflow-hidden border border-[#0F2347]/15 bg-white shadow-sm">

          <div class="bg-[#0F2347] text-white px-6 py-8 text-center">
            <h2 class="text-2xl font-bold">
              Starter
            </h2>

            <p class="mt-3 text-sm text-white/80">
              Perfect for businesses starting their online presence.
            </p>

            <div class="mt-6">
              <span class="text-4xl font-extrabold">
                ₹4999
              </span>

              <span class="text-white/70 text-sm">
                /month
              </span>
            </div>
          </div>

          <div class="p-6">
            <ul class="space-y-4 text-gray-700 text-sm md:text-base">

              <li>✓ 12 Creative Posters</li>
              <li>✓ 12 Story Designs</li>
              <li>✓ Social Media Handling</li>
              <li>✓ Captions + Smart Hashtags</li>
              <li>✓ Account Setup &amp; Optimization</li>
              <li>✓ Monthly Content Planning</li>
              <li>✓ Basic Support</li>

            </ul>

            <a
              href="/#contact"
              class="block mt-8 w-full rounded-xl bg-[#0F2347] hover:bg-blue-600 text-white text-center py-3 font-semibold transition"
            >
              Get Started
            </a>
          </div>

        </div>


        <!-- GROWTH -->
        <div class="rounded-[28px] overflow-hidden border-2 border-[#0F2347] bg-white shadow-md relative">

          <!-- Popular -->
          <div class="bg-[#0F2347] text-white text-center py-2 text-sm font-semibold">
            MOST POPULAR
          </div>

          <div class="bg-[#0F2347] text-white px-6 py-8 text-center">

            <h2 class="text-2xl font-bold">
              Growth
            </h2>

            <p class="mt-3 text-sm text-white/80">
              Designed for growing brands that need stronger engagement and consistency.
            </p>

            <div class="mt-6">
              <span class="text-4xl font-extrabold">
                ₹5999
              </span>

              <span class="text-white/70 text-sm">
                /month
              </span>
            </div>

          </div>

          <div class="p-6">
            <ul class="space-y-4 text-gray-700 text-sm md:text-base">

              <li>✓ 16 Creative Posters</li>
              <li>✓ 16 Story Designs</li>
              <li>✓ Social Media Handling</li>
              <li>✓ Captions + Smart Hashtags</li>
              <li>✓ Ad Campaign Setup</li>
              <li>✓ Monthly Performance Report</li>
              <li>✓ Content Planning</li>
              <li>✓ Priority Support</li>

            </ul>

            <a
              href="/#contact"
              class="block mt-8 w-full rounded-xl bg-[#0F2347] hover:bg-blue-600 text-white text-center py-3 font-semibold transition"
            >
              Get Started
            </a>
          </div>

        </div>


        <!-- PREMIUM -->
        <div class="rounded-[28px] overflow-hidden border border-[#0F2347]/15 bg-white shadow-sm">

          <div class="bg-[#0F2347] text-white px-6 py-8 text-center">

            <h2 class="text-2xl font-bold">
              Premium
            </h2>

            <p class="mt-3 text-sm text-white/80">
              Complete branding and marketing support for businesses.
            </p>

            <div class="mt-6">
              <span class="text-4xl font-extrabold">
                ₹7999
              </span>

              <span class="text-white/70 text-sm">
                /month
              </span>
            </div>

          </div>

          <div class="p-6">
            <ul class="space-y-4 text-gray-700 text-sm md:text-base">

              <li>✓ 21 Creative Posters</li>
              <li>✓ 21 Story Designs</li>
              <li>✓ 2 Reels / Month</li>
              <li>✓ Full Social Media Handling</li>
              <li>✓ Captions + Smart Hashtags</li>
              <li>✓ Advanced Ad Campaign Setup</li>
              <li>✓ Monthly Analytics Report</li>
              <li>✓ Account Optimization</li>
              <li>✓ Priority Support</li>

            </ul>

            <a
              href="/#contact"
              class="block mt-8 w-full rounded-xl bg-[#0F2347] hover:bg-blue-600 text-white text-center py-3 font-semibold transition"
            >
              Get Started
            </a>
          </div>

        </div>

      </div>
    </section>


    <!-- Optional Add-ons -->
    <section class="px-5 md:px-8 pb-20">
      <div class="max-w-7xl mx-auto">

        <div class="text-center mb-8">
          <h2 class="text-2xl md:text-3xl font-bold text-[#0F2347]">
            Optional Add-ons
          </h2>

          <p class="mt-2 text-gray-500">
            Additional creative and marketing services
          </p>
        </div>

        <div class="grid grid-cols-2 md:grid-cols-5 gap-4">

          <div class="rounded-2xl border p-5 text-center">
            <p class="font-semibold text-[#0F2347]">
              Logo Design
            </p>
          </div>

          <div class="rounded-2xl border p-5 text-center">
            <p class="font-semibold text-[#0F2347]">
              Brochure Design
            </p>
          </div>

          <div class="rounded-2xl border p-5 text-center">
            <p class="font-semibold text-[#0F2347]">
              Event Posters
            </p>
          </div>

          <div class="rounded-2xl border p-5 text-center">
            <p class="font-semibold text-[#0F2347]">
              Paid Advertisement Management
            </p>
          </div>

          <div class="rounded-2xl border p-5 text-center">
            <p class="font-semibold text-[#0F2347]">
              Festival Campaign Creatives
            </p>
          </div>

        </div>

      </div>
    </section>


    <!-- Bottom Note -->
    <section class="px-6 pb-16">
      <div class="max-w-4xl mx-auto text-center">

        <div class="border-t border-gray-200 pt-8">
          <p class="text-sm tracking-[0.2em] uppercase text-[#0F2347] font-semibold">
            All prices are monthly
          </p>
        </div>

      </div>
    </section>

  </main>
</MainLayout>