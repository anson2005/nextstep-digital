---
import MainLayout from "../layouts/MainLayout.astro";
import c1 from "../assets/pics/card-pic1.png";
import c2 from "../assets/pics/card-pic2.png";
import c3 from "../assets/pics/card-pic3.png";
import c4 from "../assets/pics/card-pic4.png";
import c5 from "../assets/pics/card-pic5.png";
import c6 from "../assets/pics/card-pic6.png";

const services = [
  { n: "01", title: "Social Media Management", desc: "Build a consistent presence with strategic content, creative posts, captions and ongoing account handling.", icon: "✳", href: "/services#social-media-management" },
  { n: "02", title: "Branding & Graphic Design", desc: "Create a professional, memorable identity with visual design for digital and print platforms.", icon: "◈", href: "/services#branding-graphic-design" },
  { n: "03", title: "Website Development", desc: "Modern, responsive websites designed to represent your brand and turn visitors into customers.", icon: "⌘", href: "/services#website-development" },
  { n: "04", title: "SEO", desc: "Improve online visibility and help the right audience discover your business through search.", icon: "↗", href: "/services#seo" },
  { n: "05", title: "Meta & Google Ads", desc: "Reach potential customers through targeted campaigns, audience strategy and optimization.", icon: "◎", href: "/services#meta-google-ads" },
  { n: "06", title: "Content Creation", desc: "Create useful, engaging social and promotional content that communicates your brand message.", icon: "✎", href: "/services#content-creation" },
];
const work = [
  { title: "Brand identity & design", type: "Branding · Creative design", image: c1 },
  { title: "Website experiences", type: "Web design · Development", image: c2 },
  { title: "Social media creatives", type: "Social media · Content", image: c3 },
  { title: "Campaign communication", type: "Digital campaigns · Content", image: c4 },
  { title: "Digital presence", type: "Web · Social media", image: c5 },
  { title: "Performance insights", type: "SEO · Analytics", image: c6 },
];
const steps = [
  { n: "01", title: "Discover", desc: "We start with a conversation about your business, goals, audience and current digital presence." },
  { n: "02", title: "Plan", desc: "We research your audience and shape a practical strategy around the outcomes you want." },
  { n: "03", title: "Create & launch", desc: "We develop the creative assets, website or campaigns and bring the plan to life." },
  { n: "04", title: "Review & improve", desc: "We monitor performance, share progress and refine the work as your needs evolve." },
];
const faqs = [
  { q: "What services does NextStep Digital provide?", a: "We provide social media management, branding and graphic design, website development, SEO, Meta and Google Ads, and content creation." },
  { q: "Can I choose only one service?", a: "Yes. You can enquire about an individual service or combine services based on your business requirements." },
  { q: "How do we get started?", a: "Use the contact details on this page to reach us. We will discuss your goals, requirements and the most suitable next steps." },
  { q: "Are the social media packages billed monthly?", a: "The Starter, Growth and Premium social media management plans shown on our pricing page are listed as monthly packages." },
  { q: "Do you create custom websites?", a: "Yes. Website development is one of our services. We can discuss the type of website, required pages and functionality for your project." },
];
---

<MainLayout
  title="NextStep Digital | Digital Marketing Agency in Kochi"
  description="NextStep Digital is a digital marketing agency in Kochi, Kerala offering social media management, branding, graphic design, website development, SEO, paid advertising and content creation."
>
  <div class="ns-home">
    <section class="ns-hero" id="home">
      <div class="ns-orb ns-orb-one"></div><div class="ns-orb ns-orb-two"></div>
      <div class="ns-container ns-hero-grid">
        <div class="ns-hero-copy" data-reveal>
          <span class="ns-eyebrow ns-eyebrow-dark"><i></i> Digital Marketing Agency</span>
          <h1>Strategic Digital<br />Marketing for<br /><span>Business Growth.</span></h1>
          <p>Creative, data-driven digital marketing solutions to build your brand, reach the right audience and create real business results.</p>
          <div class="ns-actions">
            <a class="ns-btn ns-btn-light" href="#contact">Get Free Consultation <span>↗</span></a>
            <a class="ns-btn ns-btn-outline" href="#services">Explore Services</a>
          </div>
          <div class="ns-hero-benefits"><span><b>⌁</b>Build Your Brand</span><i></i><span><b>◎</b>Reach The Right Audience</span><i></i><span><b>◇</b>Grow Your Business</span></div>
        </div>
        <div class="ns-hero-visual" data-reveal aria-label="Illustrated digital marketing analytics dashboard">
          <div class="ns-dashboard-orbit ns-orbit-a"></div>
          <div class="ns-dashboard-orbit ns-orbit-b"></div>
          <div class="ns-dashboard-glow"></div>
          <div class="ns-dashboard">
            <aside class="ns-dashboard-sidebar">
              <div class="ns-dashboard-brand"><span class="ns-mini-nx">N<span>X</span></span><b>NextStep<br/><em>Digital</em></b></div>
              <div class="ns-dashboard-nav active"><span>▦</span> Dashboard</div>
              <div class="ns-dashboard-nav"><span>◈</span> Campaigns</div>
              <div class="ns-dashboard-nav"><span>▥</span> Analytics</div>
              <div class="ns-dashboard-nav"><span>♙</span> Audience</div>
              <div class="ns-dashboard-nav"><span>▤</span> Reports</div>
            </aside>
            <div class="ns-dashboard-main">
              <div class="ns-dashboard-heading"><div><small>OVERVIEW</small><h3>Marketing Performance</h3></div><span class="ns-dashboard-period">Last 30 days⌄</span></div>
              <div class="ns-dashboard-chart">
                <div class="ns-chart-labels"><span>12k</span><span>8k</span><span>4k</span><span>0</span></div>
                <svg viewBox="0 0 520 190" role="img" aria-label="Upward marketing performance graph">
                  <defs><linearGradient id="nsChartFill" x1="0" x2="0" y1="0" y2="1"><stop offset="0%" stop-color="#1688ff" stop-opacity=".42"/><stop offset="100%" stop-color="#1688ff" stop-opacity="0"/></linearGradient></defs>
                  <path class="ns-chart-area" d="M8 155 L65 128 L112 137 L162 96 L211 112 L263 78 L312 88 L360 52 L410 66 L462 28 L510 12 L510 180 L8 180Z"/>
                  <path class="ns-chart-line" d="M8 155 L65 128 L112 137 L162 96 L211 112 L263 78 L312 88 L360 52 L410 66 L462 28 L510 12"/>
                  <g class="ns-chart-dots"><circle cx="65" cy="128" r="4"/><circle cx="162" cy="96" r="4"/><circle cx="263" cy="78" r="4"/><circle cx="360" cy="52" r="4"/><circle cx="462" cy="28" r="4"/><circle cx="510" cy="12" r="5"/></g>
                </svg>
              </div>
              <div class="ns-dashboard-metrics">
                <div><small>REACH</small><b>+156%</b><span>↗ Growing</span></div>
                <div><small>ENGAGEMENT</small><b>+92%</b><span>↗ Growing</span></div>
                <div><small>LEADS</small><b>+48%</b><span>↗ Growing</span></div>
              </div>
            </div>
          </div>
          <div class="ns-float-tile ns-tile-chart"><b>▥</b><span>Growth<br/>analytics</span></div>
          <div class="ns-float-tile ns-tile-target"><b>◎</b><span>Targeted<br/>campaigns</span></div>
          <div class="ns-float-tile ns-tile-megaphone"><b>◖</b></div>
        </div>
      </div>
    </section>

    <section class="ns-section ns-services" id="services">
      <div class="ns-container">
        <div class="ns-section-heading" data-reveal>
          <span class="ns-eyebrow"><i></i> What we do</span>
          <h2>End-to-end digital<br /><span>marketing solutions.</span></h2>
          <p>From strategy to execution, we bring the essential pieces of your digital presence together.</p>
        </div>
        <div class="ns-service-grid">
          {services.map((service, i) => (
            <a class="ns-service-card" href={service.href} data-tilt data-reveal>
              <div class="ns-card-top"><span class="ns-card-number">{service.n}</span><span class="ns-card-icon">{service.icon}</span></div>
              <h3>{service.title}</h3><p>{service.desc}</p>
              <span class="ns-card-arrow">↗</span>
            </a>
          ))}
        </div>
        <div class="ns-section-link"><a href="/services">Explore all services <span>↗</span></a></div>
      </div>
    </section>

    <section class="ns-about-band" id="about">
      <div class="ns-container ns-about-grid">
        <div class="ns-about-visual" data-reveal>
          <div class="ns-about-logo"><img src="/nextstep-logo.png" alt="NextStep Digital logo" /></div>
          <div class="ns-about-caption"><span>YOUR DIGITAL GROWTH PARTNER</span><b>Think forward.<br />Move NextStep.</b></div>
        </div>
        <div class="ns-about-copy" data-reveal>
          <span class="ns-eyebrow ns-eyebrow-dark"><i></i> About NextStep</span>
          <h2>A creative partner<br />for your <span>next step.</span></h2>
          <p>NextStep Digital is a creative digital marketing agency helping businesses build a strong online presence, connect with their audience and achieve sustainable growth.</p>
          <p>We bring strategy and creativity together across social media, branding, websites, SEO and digital advertising.</p>
          <div class="ns-about-points"><span>◈ Strategy first</span><span>✦ Creative execution</span><span>↗ Continuous improvement</span></div>
          <a class="ns-btn ns-btn-blue" href="/about">Know more about us <span>↗</span></a>
        </div>
      </div>
    </section>

    <section class="ns-section ns-process" id="process">
      <div class="ns-container">
        <div class="ns-section-heading" data-reveal>
          <span class="ns-eyebrow"><i></i> A clear path forward</span>
          <h2>Good work starts<br /><span>with a good process.</span></h2>
          <p>A collaborative workflow keeps every project focused, considered and moving in the right direction.</p>
        </div>
        <div class="ns-steps">
          <div class="ns-process-progress-track" aria-hidden="true"><span id="ns-process-progress"></span></div>
          {steps.map((step, i) => (
            <article class="ns-step" data-reveal>
              <div class="ns-step-top"><span>{step.n}</span><b>{i === 0 ? "◎" : i === 1 ? "⌁" : i === 2 ? "✧" : "↗"}</b></div>
              <h3>{step.title}</h3><p>{step.desc}</p>
              {i < 3 && <div class="ns-step-line"></div>}
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="ns-toolkit" id="toolkit">
      <div class="ns-container ns-toolkit-inner" data-reveal>
        <div><span class="ns-eyebrow ns-eyebrow-dark"><i></i> Connected digital channels</span><h2>The right tools.<br /><span>The right direction.</span></h2><p>We bring creative work and digital channels together to help your brand show up consistently online.</p></div>
        <div class="ns-tool-grid">
          <div><b>◎</b><span>Instagram</span></div><div><b>f</b><span>Meta platforms</span></div><div><b>G</b><span>Google Ads</span></div><div><b>⌕</b><span>Search & SEO</span></div><div><b>▣</b><span>Web experiences</span></div><div><b>✎</b><span>Creative content</span></div>
        </div>
      </div>
    </section>

    <section class="ns-section ns-pricing" id="pricing">
      <div class="ns-container">
        <div class="ns-heading-row" data-reveal>
          <div><span class="ns-eyebrow"><i></i> Our packages</span><h2>Simple plans.<br /><span>Room to grow.</span></h2></div>
          <p>Social media management plans designed for different stages of your business. Explore the full package details before choosing.</p>
        </div>
        <div class="ns-price-grid">
          <article class="ns-price-card" data-reveal data-tilt><span class="ns-plan-label">01 / STARTER</span><h3>Starter</h3><p>For businesses starting their online presence.</p><div class="ns-price">₹6,999 <small>/ month</small></div><ul><li>12 Creative Posters</li><li>12 Story Designs</li><li>Social Media Handling</li><li>Captions + Smart Hashtags</li><li>Account Setup & Optimization</li><li>Monthly Content Planning</li></ul><a href="/pricing">View package <span>↗</span></a></article>
          <article class="ns-price-card ns-price-featured" data-reveal data-tilt><span class="ns-popular">MOST POPULAR</span><span class="ns-plan-label">02 / GROWTH</span><h3>Growth</h3><p>For growing brands that need consistency.</p><div class="ns-price">₹9,999 <small>/ month</small></div><ul><li>16 Creative Posters</li><li>16 Story Designs</li><li>Social Media Handling</li><li>Captions + Smart Hashtags</li><li>Ad Campaign Setup</li><li>Monthly Performance Report</li><li>Priority Support</li></ul><a href="/pricing">View package <span>↗</span></a></article>
          <article class="ns-price-card" data-reveal data-tilt><span class="ns-plan-label">03 / PREMIUM</span><h3>Premium</h3><p>Complete branding and marketing support.</p><div class="ns-price">₹11,999 <small>/ month</small></div><ul><li>21 Creative Posters</li><li>21 Story Designs</li><li>2 Reels / Month</li><li>Full Social Media Handling</li><li>Advanced Ad Campaign Setup</li><li>Monthly Analytics Report</li><li>Priority Support</li></ul><a href="/pricing">View package <span>↗</span></a></article>
        </div>
        <p class="ns-pricing-note">All package prices are monthly. See the pricing page for complete inclusions and optional add-ons.</p>
        <div class="ns-estimator" data-reveal>
          <div class="ns-estimator-copy"><span class="ns-eyebrow"><i></i> Plan estimator</span><h3>Find the right starting point.</h3><p>Choose one of our published monthly packages to see its listed price. We can tailor the final scope after understanding your requirements.</p></div>
          <div class="ns-estimator-controls">
            <label for="ns-plan-select">Choose a package</label>
            <select id="ns-plan-select">
              <option value="6999">Starter — ₹6,999 / month</option>
              <option value="9999" selected>Growth — ₹9,999 / month</option>
              <option value="11999">Premium — ₹11,999 / month</option>
            </select>
            <div class="ns-estimator-total"><span>Listed monthly price</span><strong id="ns-estimate-value">₹9,999</strong></div>
            <a class="ns-btn ns-btn-blue" href="#contact">Discuss this package <span>↗</span></a>
            <small>Estimate reflects the package prices displayed on this page; custom services are quoted separately.</small>
          </div>
        </div>
      </div>
    </section>

    <section class="ns-section ns-why" id="why-us">
      <div class="ns-container ns-why-grid">
        <div data-reveal><span class="ns-eyebrow"><i></i> Why NextStep</span><h2>More than marketing.<br /><span>A partner in progress.</span></h2><p>We focus on the details that make your digital presence clearer, more consistent and more useful to your business.</p><a href="/about" class="ns-inline-link">Discover our approach <span>↗</span></a></div>
        <div class="ns-why-list" data-reveal><div><b>01</b><span><strong>Strategy-led thinking</strong><small>Work shaped around your goals and audience.</small></span><i>↗</i></div><div><b>02</b><span><strong>Creative consistency</strong><small>A cohesive look and message across channels.</small></span><i>↗</i></div><div><b>03</b><span><strong>Connected services</strong><small>Creative, web and marketing support in one place.</small></span><i>↗</i></div><div><b>04</b><span><strong>Ongoing improvement</strong><small>Reviewing performance and refining the approach.</small></span><i>↗</i></div></div>
      </div>
    </section>

    <section class="ns-section ns-faq" id="faq">
      <div class="ns-container ns-faq-grid">
        <div data-reveal><span class="ns-eyebrow"><i></i> FAQs</span><h2>Questions?<br /><span>Let's make it clear.</span></h2><p>Some quick answers about working with NextStep Digital.</p><a class="ns-inline-link" href="#contact">Ask us directly <span>↗</span></a></div>
        <div class="ns-faq-list" data-reveal>{faqs.map((faq, i) => <details class="ns-faq-item" open={i === 0}><summary><span>{faq.q}</span><b>+</b></summary><p>{faq.a}</p></details>)}</div>
      </div>
    </section>

    <section id="contact" class="ns-contact">
      <div class="ns-container ns-contact-inner" data-reveal>
        <div class="ns-contact-layout">
          <div class="ns-contact-copy">
            <div class="ns-contact-brand"><img src="/nextstep-logo.png" alt="NextStep Digital" /></div>
            <span class="ns-eyebrow ns-eyebrow-dark"><i></i> Get in touch</span>
            <h2>Let's Grow Together</h2>
            <p>Tell us what you're planning. We'll help you identify the right next step for your brand.</p>
            <div class="ns-contact-details">
              <a href="mailto:nextstepdigital.india@gmail.com"><b>✉</b> nextstepdigital.india@gmail.com</a>
              <a href="tel:+917306989358"><b>☎</b> +91 73069 89358</a>
              <span><b>⌖</b> Kochi, Kerala, India</span>
            </div>
            <a class="ns-instagram-link" href="https://www.instagram.com/nextstepdigital.india/" target="_blank" rel="noopener noreferrer"><img src="/instagram.svg" alt="" /> <span>@nextstepdigital.india</span> <b>↗</b></a>
          </div>
          <form class="ns-contact-form" id="ns-contact-form">
            <div class="ns-form-row"><label>Your name<input name="name" autocomplete="name" placeholder="Your name" required /></label><label>Email address<input name="email" type="email" autocomplete="email" placeholder="you@example.com" required /></label></div>
            <label>Phone number<input name="phone" type="tel" autocomplete="tel" placeholder="+91" /></label>
            <label>Service you're interested in<select name="service" required><option value="">Choose a service</option><option>Social Media Management</option><option>Branding & Graphic Design</option><option>Website Development</option><option>SEO</option><option>Meta & Google Ads</option><option>Content Creation</option><option>Multiple Services</option></select></label>
            <label>Tell us about your project<textarea name="message" rows="4" placeholder="A little about your goals, timeline and requirements..." required></textarea></label>
            <button class="ns-btn ns-btn-blue" type="submit">Send Enquiry on WhatsApp <span>↗</span></button>
            <a class="ns-email-alternative" id="ns-email-alternative" href="mailto:nextstepdigital.india@gmail.com">Prefer email? Send your enquiry by email</a>
            <small>Your details will be prepared in WhatsApp. Review the message and press Send to deliver it. No account or database is used by this website.</small>
          </form>
        </div>
        <div class="ns-contact-bottom"><span>© 2026 NextStep Digital. All Rights Reserved.</span><span>Designed &amp; Developed by NextStep Digital</span></div>
      </div>
    </section>
  </div>

  <script>
    const setupNextStepInteractions = () => {
      const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
      const revealItems = document.querySelectorAll<HTMLElement>("[data-reveal]");
      if ("IntersectionObserver" in window && !reduceMotion) {
        const observer = new IntersectionObserver((entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add("is-visible");
              observer.unobserve(entry.target);
            }
          });
        }, { threshold: 0.12 });
        revealItems.forEach((item) => observer.observe(item));
      } else revealItems.forEach((item) => item.classList.add("is-visible"));

      const process = document.querySelector<HTMLElement>(".ns-process .ns-steps");
      const progress = document.querySelector<HTMLElement>("#ns-process-progress");
      if (process && progress && !process.dataset.progressBound) {
        process.dataset.progressBound = "true";
        const updateProcessProgress = () => {
          const rect = process.getBoundingClientRect();
          const viewport = window.innerHeight || document.documentElement.clientHeight;
          const start = viewport * 0.78;
          const end = -rect.height * 0.12;
          const amount = Math.min(1, Math.max(0, (start - rect.top) / (start - end + rect.height)));
          progress.style.setProperty("--progress", `${amount * 100}%`);
        };
        updateProcessProgress();
        window.addEventListener("scroll", updateProcessProgress, { passive: true });
        window.addEventListener("resize", updateProcessProgress);
      }

      document.querySelectorAll<HTMLElement>("[data-tilt]").forEach((card) => {
        if (card.dataset.tiltReady) return;
        card.dataset.tiltReady = "true";
        card.addEventListener("pointermove", (event) => {
          if (reduceMotion || !window.matchMedia("(hover: hover) and (pointer: fine)").matches) return;
          const rect = card.getBoundingClientRect();
          const x = (event.clientX - rect.left) / rect.width;
          const y = (event.clientY - rect.top) / rect.height;
          card.style.setProperty("--rx", `${(0.5 - y) * 5}deg`);
          card.style.setProperty("--ry", `${(x - 0.5) * 6}deg`);
          card.style.setProperty("--mx", `${x * 100}%`);
          card.style.setProperty("--my", `${y * 100}%`);
        });
        card.addEventListener("pointerleave", () => {
          card.style.setProperty("--rx", "0deg");
          card.style.setProperty("--ry", "0deg");
          card.style.setProperty("--mx", "50%");
          card.style.setProperty("--my", "50%");
        });
      });
    };
    const setupExtraInteractions = () => {
      const planSelect = document.querySelector<HTMLSelectElement>("#ns-plan-select");
      const estimate = document.querySelector<HTMLElement>("#ns-estimate-value");
      if (planSelect && estimate && !planSelect.dataset.bound) {
        planSelect.dataset.bound = "true";
        const updateEstimate = () => estimate.textContent = `₹${Number(planSelect.value).toLocaleString("en-IN")}`;
        planSelect.addEventListener("change", updateEstimate);
        updateEstimate();
      }
      const form = document.querySelector<HTMLFormElement>("#ns-contact-form");
      const emailAlternative = document.querySelector<HTMLAnchorElement>("#ns-email-alternative");
      const buildEnquiry = () => {
        if (!form) return null;
        const data = new FormData(form);
        const name = String(data.get("name") || "").trim();
        const email = String(data.get("email") || "").trim();
        const phone = String(data.get("phone") || "").trim();
        const service = String(data.get("service") || "").trim();
        const message = String(data.get("message") || "").trim();
        const subject = `Website enquiry — ${service || "New project"}`;
        const body = `New enquiry from NextStep Digital website

Name: ${name}
Email: ${email}
Phone: ${phone || "Not provided"}
Service: ${service}

Project details:
${message}`;
        return { subject, body };
      };
      const updateEmailLink = () => {
        const enquiry = buildEnquiry();
        if (emailAlternative && enquiry) emailAlternative.href = `mailto:nextstepdigital.india@gmail.com?subject=${encodeURIComponent(enquiry.subject)}&body=${encodeURIComponent(enquiry.body)}`;
      };
      if (form && !form.dataset.bound) {
        form.dataset.bound = "true";
        form.addEventListener("input", updateEmailLink);
        form.addEventListener("change", updateEmailLink);
        emailAlternative?.addEventListener("click", updateEmailLink);
        form.addEventListener("submit", (event) => {
          event.preventDefault();
          if (!form.reportValidity()) return;
          const enquiry = buildEnquiry();
          if (!enquiry) return;
          const whatsappMessage = encodeURIComponent(`${enquiry.subject}

${enquiry.body}`);
          window.open(`https://wa.me/917306989358?text=${whatsappMessage}`, "_blank", "noopener,noreferrer");
        });
        updateEmailLink();
      }
      if (!window.matchMedia("(prefers-reduced-motion: reduce)").matches && window.matchMedia("(hover: hover) and (pointer: fine)").matches && !document.body.dataset.cursorGlow) {
        document.body.dataset.cursorGlow = "true";
        const glow = document.createElement("div");
        glow.className = "ns-cursor-glow";
        document.body.appendChild(glow);
        let frame = 0;
        window.addEventListener("pointermove", (event) => {
          if (frame) cancelAnimationFrame(frame);
          frame = requestAnimationFrame(() => {
            glow.style.transform = `translate3d(${event.clientX - 140}px,${event.clientY - 140}px,0)`;
            glow.style.opacity = "1";
          });
        }, { passive: true });
        document.addEventListener("pointerleave", () => glow.style.opacity = "0");
      }
    };
    setupNextStepInteractions();
    setupExtraInteractions();
    document.addEventListener("astro:page-load", () => { setupNextStepInteractions(); setupExtraInteractions(); });
  </script>

  <style>
    .ns-home{margin-top:-82px;--navy:#061633;--navy2:#0b2550;--blue:#1769f5;--electric:#4aa2ff;--ink:#091a38;--muted:#65738d;--pale:#f3f7ff;color:var(--ink);overflow:hidden}
