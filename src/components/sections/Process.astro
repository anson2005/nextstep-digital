---
import Accordion from "../ui/Accordion.astro";
import SectionTitle from "../ui/SectionTitle.astro";
import Section from "./Section.astro";

const description =
  "A streamlined workflow that helps us deliver creative, effective, and result-driven digital solutions for every client.";
---

<Section id="process">
  <div class="mt-[140px]">
    <SectionTitle
      sectionTitle="How We Work"
      description={description}
    />
    <Accordion />
  </div>
</Section>

