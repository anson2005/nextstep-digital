---
import Section from "./Section.astro";
import { Image } from "astro:assets";
import HeroIlust from "../../assets/pics/hero.svg";
---

<Section id="home">
<div class="relative flex flex-col-reverse items-center md:flex-row" id="hero">
    <div class="row items-center py-5 md:w-6/12 md:pb-20 md:pt-10">
        <div class="text-left space-y-3">
          <h1 class="text-4xl font-bold leading-tight md:text-6xl text-center md:text-left">
  Transform Your <br />
  Business with <br />
  NextStep Digital
</h1>
            <p class="mt-6 text-lg text-gray-600 text-center md:text-left">
  We help businesses grow through branding, social media management,
  graphic design, website development, SEO, and content creation.
</p>
            <div class="w-full justify-center md:justify-start items-center inline-flex">
                <a href="#contact" target="_blank" class="px-8 py-5 bg-zinc-900 hover:bg-blue-900 rounded-2xl text-center text-white border text-xl font-normal leading-7 transition-all duration-300">Get Free Consultation
                </a>
            </div>
        </div>
    </div>
    <div class="flex items-center py-5 md:w-6/12 md:pb-20 md:pt-10">
        <Image src={HeroIlust} alt="NextStep Digital Hero" loading="eager" />
    </div>
</div>
</Section>

