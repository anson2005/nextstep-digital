---
import Section from "./Section.astro";
import { Image } from "astro:assets";
import HeroIlust from "../../assets/pics/hero.svg";
---

<Section id="home">
<div class="relative flex flex-col-reverse items-center md:flex-row" id="hero">
    <div class="row items-center py-2 md:w-6/12 md:pb-20 md:pt-10">
        <div class="text-left space-y-3">
         <h1 class="text-4xl sm:text-5xl md:text-6xl font-bold leading-tight text-center md:text-left">
  Transform Your <br />
  Business with <br />
  NextStep Digital
</h1>
            <p class="mt-6 text-base md:text-lg text-gray-600 text-center md:text-left max-w-xl mx-auto md:mx-0">
  We help businesses grow through branding, social media management,
  graphic design, website development, SEO, and content creation.
</p>
            <div class="flex justify-center md:justify-start w-full">
  <a
    href="#contact"
    class="w-full sm:w-auto max-w-sm px-6 py-4 bg-zinc-900 hover:bg-blue-700 rounded-2xl text-center text-white text-lg md:text-xl font-medium transition-all duration-300"
  >
    Get Free Consultation
  </a>
</div>
        </div>
    </div>
   <div class="flex justify-center items-center py-4 md:w-6/12 md:pb-20 md:pt-10">
<img
  src="/hero-nextstep.png"
  alt="NextStep Digital Hero"
  class="w-80 sm:w-96 md:w-full h-auto mx-auto"
/>
</div>
</div>
</Section>

