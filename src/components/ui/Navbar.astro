---
const menuitems = [
  { href: '/', label: 'Home' },
  { href: '/services', label: 'Services' },
  { href: '/about', label: 'About' },
  { href: '/pricing', label: 'Pricing' },
  { href: '/#contact', label: 'Contact' },
];
---
<header class="ns-nav-shell">
  <nav class="ns-nav" aria-label="Main navigation">
    <a href="/" class="ns-nav-logo" aria-label="NextStep Digital home"><img src="/nextstep-logo.png" alt="NextStep Digital" /></a>
    <button class="ns-menu-toggle" type="button" aria-label="Open navigation menu" aria-expanded="false" aria-controls="ns-nav-links"><span></span><span></span></button>
    <div class="ns-nav-links" id="ns-nav-links">
      {menuitems.map((item) => <a href={item.href}>{item.label}</a>)}
      <a class="ns-nav-cta" href="/#contact">Get a Free Consultation <span>↗</span></a>
    </div>
  </nav>
</header>
<style>
  .ns-nav-shell{position:fixed;z-index:100;inset:0 0 auto;background:rgba(4,17,41,.92);backdrop-filter:blur(18px);border-bottom:1px solid rgba(132,185,255,.16)}
  .ns-nav{width:min(1160px,calc(100% - 48px));height:82px;margin:auto;display:flex;align-items:center;justify-content:space-between;gap:30px}
  .ns-nav-logo{display:flex;align-items:center;flex:none}.ns-nav-logo img{width:145px;height:auto;max-height:54px;object-fit:contain;border-radius:5px}
  .ns-nav-links{display:flex;align-items:center;gap:27px}.ns-nav-links>a{color:#e5efff;font-size:13px;font-weight:600;transition:color .2s}.ns-nav-links>a:hover{color:#70b5ff}.ns-nav-links .ns-nav-cta{border:1px solid #3989ff;border-radius:99px;padding:12px 17px;box-shadow:0 0 18px #1769ed35;color:#fff}.ns-nav-cta span{margin-left:8px;color:#8fc4ff;font-size:16px}
  .ns-menu-toggle{display:none;background:transparent;border:1px solid #5c8dcb;border-radius:10px;width:42px;height:40px;align-items:center;justify-content:center;flex-direction:column;gap:5px}.ns-menu-toggle span{display:block;width:18px;height:2px;background:#fff;border-radius:4px}
  @media(max-width:850px){.ns-nav{height:70px;width:calc(100% - 34px)}.ns-nav-logo img{width:126px}.ns-menu-toggle{display:flex}.ns-nav-links{display:none;position:absolute;top:70px;left:0;right:0;padding:18px 22px 24px;background:#061633;border-bottom:1px solid #ffffff24;align-items:stretch;gap:0;flex-direction:column}.ns-nav-links.is-open{display:flex}.ns-nav-links>a{padding:13px 5px;border-bottom:1px solid #ffffff12}.ns-nav-links .ns-nav-cta{text-align:center;margin-top:14px;border:1px solid #3989ff;padding:14px}}
</style>
<script>
  const navToggle = document.querySelector<HTMLButtonElement>(".ns-menu-toggle");
  const navLinks = document.querySelector<HTMLElement>("#ns-nav-links");
  navToggle?.addEventListener("click", () => {
    const open = navLinks?.classList.toggle("is-open") ?? false;
    navToggle.setAttribute("aria-expanded", String(open));
    navToggle.setAttribute("aria-label", open ? "Close navigation menu" : "Open navigation menu");
  });
  if (navLinks) {
    navLinks.querySelectorAll("a").forEach((link) => link.addEventListener("click", () => {
      navLinks.classList.remove("is-open");
      navToggle?.setAttribute("aria-expanded", "false");
    }));
  }
</script>
